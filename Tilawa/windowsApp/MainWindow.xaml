<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TilawaWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Shared core is consumed through CoreClient (P/Invoke over Shared.dll).
         See .opencode/skills/winui-bridge. -->
    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsSettingsVisible="False"
                    Header="Tilawa">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Library" Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="Tilawa — Windows shell"
                       FontSize="32"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="GreetingText"
                       HorizontalAlignment="Center"
                       Foreground="Gray" />
        </StackPanel>
    </NavigationView>
</Window>
